<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/islandRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/island_bg"
    android:clipToOutline="true"
    android:elevation="8dp">

    <!-- Idle state -->
    <LinearLayout
        android:id="@+id/idleView"
        android:layout_width="120dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible" />

    <!-- Notification state -->
    <LinearLayout
        android:id="@+id/notifView"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/notifIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notifApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/notifTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/notifText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Reply box -->
        <LinearLayout
            android:id="@+id/replyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/replyInput"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:hint="Reply..."
                android:textColorHint="#666666"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/reply_input_bg"
                android:padding="6dp"
                android:gravity="center_vertical"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/sendBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Send"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/accept_btn_bg"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="6dp"
                android:clickable="true" />
        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:id="@+id/notifActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReply"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="↩ Reply"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/reply_btn_bg"
                android:gravity="center"
                android:clickable="true" />

            <TextView
                android:id="@+id/btnRead"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="✓ Read"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:background="@drawable/read_btn_bg"
                android:gravity="center"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Music state -->
    <LinearLayout
        android:id="@+id/musicView"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/albumArt"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/album_art_bg"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/musicArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPrev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="⏮"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="⏸"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:background="@drawable/play_btn_bg"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btnNext"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="⏭"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:clickable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Call state -->
    <LinearLayout
        android:id="@+id/callView"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/callerAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="20sp"
            android:text="👤"
            android:background="@drawable/avatar_bg"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/callerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="11sp"
                android:text="Incoming call..." />
        </LinearLayout>

        <TextView
            android:id="@+id/btnDecline"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="✕"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/decline_btn_bg"
            android:layout_marginEnd="8dp"
            android:clickable="true" />

        <TextView
            android:id="@+id/btnAccept"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="✓"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/accept_btn_bg"
            android:clickable="true" />
    </LinearLayout>

    <!-- Charging state -->
    <LinearLayout
        android:id="@+id/chargingView"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="22sp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Charging" />

            <TextView
                android:id="@+id/chargingLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>